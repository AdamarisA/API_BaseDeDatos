@model API_BaseDeDatos.Models.PokemonDetail


<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: 'Poppins', 'Sans Serif Collection';
            background: #020024;
            background: linear-gradient(90deg, rgba(2, 0, 36, 1) 0%, rgba(9, 9, 121, 1) 35%, rgba(2, 157, 219, 1) 83%, rgba(1, 191, 241, 1) 93%, rgba(0, 212, 255, 1) 100%);
            margin: 20px;
        }

        h2 {
            color: black; 
            border-bottom: 2px solid #A9A9A9; 
            padding-bottom: 5px;
        }

        p {
            font-size: 20px;
            margin: 8px 0;
        }

        strong {
            color: #4682B4; 
        }

        

        .card {
            background-color: #FFFAFA;
            border: 2px solid black;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0px 4px 8px rgba(0,0,0,0.1);
            max-width: 400px;
        }
        .text-Black{

            color :black ;

        }
    </style >
</head>
<body>
    <div class="card">
        <h2>Detalle de : @Model.Name</h2> 
        <p><strong>ID:</strong><span class="text-black">@Model.Id</span></p>
        <p><strong>Altura:</strong><span class="text-black">@Model.Height</span></p>
        <p><strong>Peso:</strong><span class="text-black">@Model.Weight</span></p>
    </div>
</body>
</html>