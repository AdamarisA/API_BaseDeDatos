@model API_BaseDeDatos.Models.PokemonDetail


<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="https://imgs.search.brave.com/fOVQ9QXBxAIT2-jjrUBenYmAwq83Kw26gALv8GItGic/rs:fit:500:0:1:0/g:ce/aHR0cHM6Ly9zdDIu/ZGVwb3NpdHBob3Rv/cy5jb20vMTkwNjcx/MS8xMTk0NC92LzQ1/MC9kZXBvc2l0cGhv/dG9zXzExOTQ0MTkw/NC1zdG9jay1pbGx1/c3RyYXRpb24tcG9r/ZWJhbGwtaGFuZ2lu/Zy1pbi10aGUtYWly/LmpwZw">

    <style>
